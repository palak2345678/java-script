<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Symbiosis Institute of Technology - Grading Portal</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Segoe UI',sans-serif;
}

body{
background:linear-gradient(135deg,#667eea,#764ba2);
min-height:100vh;
padding:30px;
}

.container{
display:flex;
gap:25px;
flex-wrap:wrap;
}

.card{
flex:1;
min-width:400px;
background:white;
border-radius:20px;
padding:25px;
box-shadow:0 10px 30px rgba(0,0,0,0.15);
}

h1{
color:#4a3aff;
text-align:center;
margin-bottom:5px;
}

.subtitle{
text-align:center;
color:#666;
margin-bottom:25px;
}

label{
display:block;
margin-top:15px;
font-weight:600;
}

input{
width:100%;
padding:12px;
margin-top:5px;
border:2px solid #ddd;
border-radius:10px;
font-size:15px;
}

.subject-row{
display:flex;
gap:10px;
margin-top:10px;
}

.subject-row input:first-child{
flex:2;
}

.subject-row input:nth-child(2){
flex:1;
}

.delete-btn{
background:#ff4d4d;
color:white;
border:none;
padding:10px 14px;
border-radius:10px;
cursor:pointer;
}

.add-btn{
margin-top:15px;
background:#4CAF50;
color:white;
border:none;
padding:12px;
width:100%;
border-radius:10px;
cursor:pointer;
font-size:15px;
}

.generate-btn{
margin-top:15px;
background:#4a3aff;
color:white;
border:none;
padding:14px;
width:100%;
border-radius:10px;
font-size:16px;
cursor:pointer;
}

.transcript{
border:3px dashed #7b61ff;
}

.transcript h2{
text-align:center;
color:#1e3a8a;
}

.transcript h4{
text-align:center;
color:#555;
margin-bottom:20px;
}

table{
width:100%;
border-collapse:collapse;
margin-top:20px;
}

th,td{
padding:10px;
border-bottom:1px solid #ddd;
}

th{
background:#eef2ff;
}

.grade{
padding:5px 10px;
border-radius:8px;
color:white;
font-weight:bold;
}

.A{background:#22c55e;}
.B{background:#3b82f6;}
.C{background:#f59e0b;}
.D{background:#ef4444;}
.F{background:#991b1b;}

.summary{
margin-top:20px;
line-height:2;
font-size:17px;
}

.pass{
color:green;
font-weight:bold;
}

.fail{
color:red;
font-weight:bold;
}
</style>
</head>

<body>

<div class="container">

<div class="card">
<h1>🎓 Symbiosis Institute of Technology</h1>
<p class="subtitle">Student Grading Portal</p>

<label>Student Name</label>
<input type="text" id="studentName" placeholder="Enter Name">

<label>PRN Number</label>
<input type="text" id="prn" placeholder="Enter PRN">

<label>Subjects & Marks</label>

<div id="subjects">
<div class="subject-row">
<input type="text" value="Engineering Mathematics">
<input type="number" value="75">
<button class="delete-btn" onclick="removeSubject(this)">🗑</button>
</div>

<div class="subject-row">
<input type="text" value="Data Structures">
<input type="number" value="82">
<button class="delete-btn" onclick="removeSubject(this)">🗑</button>
</div>
</div>

<button class="add-btn" onclick="addSubject()">+ Add Subject</button>

<button class="generate-btn" onclick="generateTranscript()">
Generate Transcript
</button>
</div>

<div class="card transcript">
<h2>SYMBIOSIS INSTITUTE OF TECHNOLOGY</h2>
<h4>Official Academic Transcript</h4>

<p><b>Name:</b> <span id="displayName">-</span></p>
<p><b>PRN:</b> <span id="displayPrn">-</span></p>

<table>
<thead>
<tr>
<th>Subject</th>
<th>Marks</th>
<th>Grade</th>
</tr>
</thead>

<tbody id="resultBody"></tbody>
</table>

<div class="summary">
<p><b>Total:</b> <span id="totalMarks">0</span></p>
<p><b>Percentage:</b> <span id="percentage">0%</span></p>
<p><b>Result:</b> <span id="resultStatus">-</span></p>
</div>
</div>

</div>

<script>
function addSubject(){
let div=document.createElement("div");
div.className="subject-row";

div.innerHTML=`
<input type="text" placeholder="Subject Name">
<input type="number" placeholder="Marks">
<button class="delete-btn" onclick="removeSubject(this)">🗑</button>
`;

document.getElementById("subjects").appendChild(div);
}

function removeSubject(btn){
btn.parentElement.remove();
}

function getGrade(mark){

if(mark>=90) return "A+";
if(mark>=80) return "A";
if(mark>=70) return "B";
if(mark>=60) return "C";
if(mark>=50) return "D";

return "F";
}

function generateTranscript(){

let name=document.getElementById("studentName").value;
let prn=document.getElementById("prn").value;

document.getElementById("displayName").innerText=name;
document.getElementById("displayPrn").innerText=prn;

let rows=document.querySelectorAll(".subject-row");

let body="";
let total=0;
let failed=false;

rows.forEach(row=>{

let subject=row.children[0].value;
let marks=parseInt(row.children[1].value)||0;

total+=marks;

let grade=getGrade(marks);

if(marks<50)
failed=true;

let gradeClass="F";

if(grade==="A+" || grade==="A")
gradeClass="A";
else if(grade==="B")
gradeClass="B";
else if(grade==="C")
gradeClass="C";
else if(grade==="D")
gradeClass="D";

body+=`
<tr>
<td>${subject}</td>
<td>${marks}/100</td>
<td>
<span class="grade ${gradeClass}">
${grade}
</span>
</td>
</tr>`;
});

document.getElementById("resultBody").innerHTML=body;

let percentage=(total/(rows.length*100))*100;

document.getElementById("totalMarks").innerText=
`${total}/${rows.length*100}`;

document.getElementById("percentage").innerText=
percentage.toFixed(2)+"%";

let result=document.getElementById("resultStatus");

if(failed){
result.innerHTML="<span class='fail'>FAILED</span>";
}else{
result.innerHTML="<span class='pass'>PASSED</span>";
}
}
</script>

</body>
</html>

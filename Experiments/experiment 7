<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Revolution Fitness - Admission Form</title>

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: "Segoe UI", Arial, sans-serif;
        }

        body {
            height: 100vh;
            overflow: hidden;
            background: linear-gradient(
                135deg,
                #eef2ff,
                #f8fafc,
                #fce7f3
            );
            color: #334155;
        }

        /* MAIN CONTAINER */

        .container {
            width: 96%;
            height: 94vh;
            margin: 3vh auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 15px 40px rgba(71, 85, 105, 0.15);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        /* HEADER */

        .header {
            height: 105px;
            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 18px 35px;

            background: linear-gradient(
                120deg,
                #dbeafe,
                #ede9fe,
                #fce7f3
            );
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .logo {
            width: 65px;
            height: 65px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: white;
            border-radius: 50%;

            font-size: 32px;

            box-shadow: 0 5px 15px rgba(99, 102, 241, 0.12);
        }

        .header h1 {
            font-size: 30px;
            letter-spacing: 2px;
            color: #4f46e5;
        }

        .header p {
            margin-top: 4px;
            color: #64748b;
            font-size: 13px;
        }

        .developer-top {
            text-align: right;
            font-size: 12px;
            color: #64748b;
        }

        .developer-top strong {
            color: #4f46e5;
        }

        /* CONTENT */

        .content {
            flex: 1;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0;
            min-height: 0;
        }

        .left,
        .right {
            padding: 18px 28px;
            min-height: 0;
        }

        .left {
            border-right: 1px solid #e2e8f0;
        }

        /* SECTION */

        .section-title {
            font-size: 16px;
            color: #4f46e5;

            margin-bottom: 10px;
            padding-bottom: 5px;

            border-bottom: 2px solid #e0e7ff;
        }

        /* FORM GRID */

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px 15px;
        }

        .field {
            margin-bottom: 7px;
        }

        label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 4px;
            color: #475569;
        }

        input,
        select,
        textarea {
            width: 100%;

            padding: 8px 10px;

            border: 1.5px solid #dbe2ea;

            border-radius: 7px;

            background: #f8fafc;

            color: #334155;

            outline: none;

            font-size: 12px;

            transition: 0.2s;
        }

        input:focus,
        select:focus,
        textarea:focus {
            border-color: #818cf8;
            background: white;

            box-shadow:
                0 0 0 3px
                rgba(129, 140, 248, 0.10);
        }

        input.valid,
        select.valid {
            border-color: #22c55e;
            background: #f0fdf4;
        }

        input.invalid,
        select.invalid {
            border-color: #ef4444;
            background: #fef2f2;
        }

        .error {
            min-height: 13px;
            margin-top: 2px;

            color: #ef4444;

            font-size: 10px;
        }

        /* GENDER */

        .gender {
            display: flex;
            gap: 20px;
            margin-top: 4px;
        }

        .gender label {
            font-weight: 500;
        }

        .gender input {
            width: auto;
            margin-right: 4px;
        }

        /* PASSWORD */

        .strength {
            height: 4px;
            margin-top: 4px;

            background: #e2e8f0;

            border-radius: 10px;
            overflow: hidden;
        }

        .strength-bar {
            width: 0%;
            height: 100%;
            transition: 0.3s;
        }

        /* BMI */

        .bmi-box {
            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 10px 15px;

            margin: 10px 0;

            border-radius: 10px;

            background: linear-gradient(
                135deg,
                #eef2ff,
                #fdf2f8
            );

            border: 1px solid #e0e7ff;
        }

        .bmi-value {
            font-size: 22px;
            font-weight: bold;
            color: #4f46e5;
        }

        .bmi-status {
            font-size: 11px;
            color: #64748b;
        }

        /* MEMBERSHIP */

        .plans {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }

        .plan {
            padding: 10px 5px;

            text-align: center;

            border: 1.5px solid #e2e8f0;

            border-radius: 9px;

            cursor: pointer;

            transition: 0.2s;

            background: white;
        }

        .plan:hover {
            border-color: #a5b4fc;
            transform: translateY(-2px);
        }

        .plan.selected {
            background: #eef2ff;
            border-color: #6366f1;
        }

        .plan input {
            display: none;
        }

        .plan h3 {
            font-size: 13px;
            color: #4f46e5;
            margin-bottom: 3px;
        }

        .plan p {
            font-size: 9px;
            color: #64748b;
            line-height: 13px;
        }

        .price {
            font-size: 13px;
            font-weight: bold;
            margin-top: 5px;
            color: #334155;
        }

        /* PHOTO */

        .photo-area {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .photo-input {
            flex: 1;
        }

        .preview {
            display: none;

            width: 65px;
            height: 65px;

            object-fit: cover;

            border-radius: 50%;

            border: 3px solid #c7d2fe;
        }

        /* TERMS */

        .terms {
            display: flex;
            align-items: center;
            gap: 7px;

            margin: 10px 0;
        }

        .terms input {
            width: auto;
        }

        .terms label {
            margin: 0;
            font-size: 11px;
        }

        /* BUTTONS */

        .buttons {
            display: flex;
            gap: 10px;
            margin-top: 10px;
        }

        button {
            flex: 1;

            border: none;

            padding: 10px;

            border-radius: 8px;

            font-size: 13px;
            font-weight: 600;

            cursor: pointer;

            transition: 0.2s;
        }

        .submit-btn {
            background: linear-gradient(
                135deg,
                #6366f1,
                #8b5cf6
            );

            color: white;
        }

        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow:
                0 5px 15px
                rgba(99, 102, 241, 0.25);
        }

        .reset-btn {
            background: #f1f5f9;
            color: #475569;
        }

        /* RESULT */

        #result {
            display: none;

            margin-top: 8px;

            padding: 9px;

            border-radius: 8px;

            background: #f0fdf4;

            border: 1px solid #86efac;

            color: #166534;

            font-size: 11px;
        }

        #result h3 {
            font-size: 13px;
            margin-bottom: 3px;
        }

        /* FOOTER */

        .footer {
            height: 35px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: #f8fafc;

            border-top: 1px solid #e2e8f0;

            font-size: 11px;

            color: #64748b;
        }

        .footer strong {
            color: #4f46e5;
        }

    </style>
</head>



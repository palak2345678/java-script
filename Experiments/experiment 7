<script>

    // =========================================
    // FORM ACCESS
    // =========================================

    const form = document.getElementById("gymForm");

    const name =
        document.getElementById("name");

    const email =
        document.getElementById("email");

    const phone =
        document.getElementById("phone");

    const dob =
        document.getElementById("dob");

    const password =
        document.getElementById("password");

    const confirmPassword =
        document.getElementById("confirmPassword");

    const height =
        document.getElementById("height");

    const weight =
        document.getElementById("weight");

    const bmi =
        document.getElementById("bmi");

    const bmiStatus =
        document.getElementById("bmiStatus");

    const strengthBar =
        document.getElementById("strengthBar");

    const photo =
        document.getElementById("photo");

    const preview =
        document.getElementById("preview");


    // =========================================
    // NAME INPUT EVENT
    // =========================================

    name.addEventListener("input", function () {

        if (name.value.trim().length < 3) {

            name.classList.add("invalid");
            name.classList.remove("valid");

            document.getElementById("nameError")
                .textContent =
                "Enter at least 3 characters.";

        } else {

            name.classList.add("valid");
            name.classList.remove("invalid");

            document.getElementById("nameError")
                .textContent =
                "✓ Valid name";

        }

    });


    // =========================================
    // EMAIL INPUT EVENT
    // =========================================

    email.addEventListener("input", function () {

        const pattern =
            /^[^ ]+@[^ ]+\.[a-z]{2,3}$/;

        if (!pattern.test(email.value)) {

            email.classList.add("invalid");
            email.classList.remove("valid");

            document.getElementById("emailError")
                .textContent =
                "Enter a valid email.";

        } else {

            email.classList.add("valid");
            email.classList.remove("invalid");

            document.getElementById("emailError")
                .textContent =
                "✓ Valid email";

        }

    });


    // =========================================
    // PHONE INPUT EVENT
    // =========================================

    phone.addEventListener("input", function () {

        phone.value =
            phone.value.replace(/\D/g, "");

        if (phone.value.length !== 10) {

            phone.classList.add("invalid");
            phone.classList.remove("valid");

            document.getElementById("phoneError")
                .textContent =
                "Enter 10 digit number.";

        } else {

            phone.classList.add("valid");
            phone.classList.remove("invalid");

            document.getElementById("phoneError")
                .textContent =
                "✓ Valid number";

        }

    });


    // =========================================
    // PASSWORD INPUT EVENT
    // =========================================

    password.addEventListener("input", function () {

        const value =
            password.value;

        let strength = 0;

        if (value.length >= 6)
            strength++;

        if (/[A-Z]/.test(value))
            strength++;

        if (/[0-9]/.test(value))
            strength++;

        if (/[^A-Za-z0-9]/.test(value))
            strength++;


        strengthBar.style.width =
            (strength * 25) + "%";


        if (strength <= 1) {

            strengthBar.style.background =
                "#ef4444";

            document.getElementById(
                "passwordError"
            ).textContent =
                "Weak password";

        }

        else if (strength <= 3) {

            strengthBar.style.background =
                "#f59e0b";

            document.getElementById(
                "passwordError"
            ).textContent =
                "Medium password";

        }

        else {

            strengthBar.style.background =
                "#22c55e";

            document.getElementById(
                "passwordError"
            ).textContent =
                "✓ Strong password";

        }

    });


    // =========================================
    // CONFIRM PASSWORD INPUT EVENT
    // =========================================

    confirmPassword.addEventListener(
        "input",
        function () {

            if (
                confirmPassword.value !==
                password.value
            ) {

                confirmPassword.classList.add(
                    "invalid"
                );

                document.getElementById(
                    "confirmError"
                ).textContent =
                    "Passwords don't match.";

            }

            else {

                confirmPassword.classList.add(
                    "valid"
                );

                confirmPassword.classList.remove(
                    "invalid"
                );

                document.getElementById(
                    "confirmError"
                ).textContent =
                    "✓ Passwords match";

            }

        }
    );


    // =========================================
    // BMI CALCULATOR
    // =========================================

    function calculateBMI() {

        const h =
            parseFloat(height.value);

        const w =
            parseFloat(weight.value);


        if (h > 0 && w > 0) {

            const value =
                w / ((h / 100) ** 2);

            bmi.textContent =
                value.toFixed(1);


            if (value < 18.5) {

                bmiStatus.textContent =
                    "Underweight";

            }

            else if (value < 25) {

                bmiStatus.textContent =
                    "Normal Weight";

            }

            else if (value < 30) {

                bmiStatus.textContent =
                    "Overweight";

            }

            else {

                bmiStatus.textContent =
                    "Obese";

            }

        }

        else {

            bmi.textContent = "--";

            bmiStatus.textContent =
                "Enter height & weight";

        }

    }


    height.addEventListener(
        "input",
        calculateBMI
    );

    weight.addEventListener(
        "input",
        calculateBMI
    );


    // =========================================
    // MEMBERSHIP CLICK EVENT
    // =========================================

    const plans =
        document.querySelectorAll(".plan");


    plans.forEach(function (plan) {

        plan.addEventListener(
            "click",
            function () {

                plans.forEach(function (p) {

                    p.classList.remove(
                        "selected"
                    );

                });

                plan.classList.add(
                    "selected"
                );

            }
        );

    });


    // =========================================
    // PHOTO CHANGE EVENT
    // =========================================

    photo.addEventListener(
        "change",
        function () {

            const file =
                photo.files[0];

            if (file) {

                preview.src =
                    URL.createObjectURL(file);

                preview.style.display =
                    "block";

            }

        }
    );


    // =========================================
    // DOB CHANGE EVENT
    // =========================================

    dob.addEventListener(
        "change",
        function () {

            const birthDate =
                new Date(dob.value);

            const today =
                new Date();

            let age =
                today.getFullYear() -
                birthDate.getFullYear();


            const month =
                today.getMonth() -
                birthDate.getMonth();


            if (
                month < 0 ||
                (
                    month === 0 &&
                    today.getDate() <
                    birthDate.getDate()
                )
            ) {

                age--;

            }


            if (age < 16) {

                dob.classList.add(
                    "invalid"
                );

                document.getElementById(
                    "dobError"
                ).textContent =
                    "Minimum age is 16.";

            }

            else {

                dob.classList.add(
                    "valid"
                );

                dob.classList.remove(
                    "invalid"
                );

                document.getElementById(
                    "dobError"
                ).textContent =
                    "✓ Age verified";

            }

        }
    );


    // =========================================
    // FORM SUBMIT EVENT
    // =========================================

    form.addEventListener(
        "submit",
        function (event) {

            event.preventDefault();


            // NAME

            if (
                name.value.trim().length < 3
            ) {

                alert(
                    "Please enter your name."
                );

                name.focus();

                return;

            }


            // EMAIL

            const emailPattern =
                /^[^ ]+@[^ ]+\.[a-z]{2,3}$/;


            if (
                !emailPattern.test(
                    email.value
                )
            ) {

                alert(
                    "Please enter a valid email."
                );

                email.focus();

                return;

            }


            // PHONE

            if (
                phone.value.length !== 10
            ) {

                alert(
                    "Enter a valid 10 digit number."
                );

                phone.focus();

                return;

            }


            // PASSWORD

            if (
                password.value.length < 6
            ) {

                alert(
                    "Password must have at least 6 characters."
                );

                password.focus();

                return;

            }


            // CONFIRM PASSWORD

            if (
                password.value !==
                confirmPassword.value
            ) {

                alert(
                    "Passwords do not match."
                );

                confirmPassword.focus();

                return;

            }


            // GENDER

            const gender =
                document.querySelector(
                    'input[name="gender"]:checked'
                );


            if (!gender) {

                alert(
                    "Please select gender."
                );

                return;

            }


            // MEMBERSHIP

            const membership =
                document.querySelector(
                    'input[name="membership"]:checked'
                );


            if (!membership) {

                alert(
                    "Please select membership."
                );

                return;

            }


            // TERMS

            if (
                !document.getElementById(
                    "terms"
                ).checked
            ) {

                document.getElementById(
                    "termsError"
                ).textContent =
                    "Please accept the terms.";

                return;

            }


            // SUCCESS

            const result =
                document.getElementById(
                    "result"
                );

            const resultText =
                document.getElementById(
                    "resultText"
                );


            result.style.display =
                "block";


            resultText.innerHTML =

                "<b>Name:</b> " +
                name.value +

                " &nbsp; | &nbsp; " +

                "<b>Plan:</b> " +
                membership.value +

                "<br>" +

                "<b>BMI:</b> " +
                bmi.textContent +

                " &nbsp; | &nbsp; " +

                "<b>Goal:</b> " +
                document.getElementById(
                    "goal"
                ).value;


        }
    );


    // =========================================
    // RESET EVENT
    // =========================================

    form.addEventListener(
        "reset",
        function () {

            setTimeout(function () {

                document
                    .querySelectorAll(
                        "input, select"
                    )
                    .forEach(function (element) {

                        element.classList.remove(
                            "valid"
                        );

                        element.classList.remove(
                            "invalid"
                        );

                    });


                document
                    .querySelectorAll(
                        ".error"
                    )
                    .forEach(function (error) {

                        error.textContent = "";

                    });


                plans.forEach(
                    function (plan) {

                        plan.classList.remove(
                            "selected"
                        );

                    }
                );


                strengthBar.style.width =
                    "0%";


                bmi.textContent =
                    "--";


                bmiStatus.textContent =
                    "Enter height & weight";


                preview.style.display =
                    "none";


                document.getElementById(
                    "result"
                ).style.display =
                    "none";


            }, 0);

        }
    );

</script>

</body>
</html>

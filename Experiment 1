<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CSS Types Demo</title>

    <!-- Internal CSS -->
    <style>
        body{
            font-family: Arial, sans-serif;
            background:#f4f4f4;
            margin:40px;
        }

        h1{
            text-align:center;
        }

        .student-info{
            text-align:center;
            margin-bottom:30px;
            font-size:18px;
            font-weight:bold;
        }

        .container{
            display:flex;
            justify-content:center;
            gap:30px;
        }

        .box{
            width:250px;
            padding:20px;
            text-align:center;
            border-radius:10px;
            box-shadow:0px 0px 10px gray;
            background:white;
        }

        .internal{
            background:#e8f5e9;
        }

        button{
            padding:10px 20px;
            border:none;
            border-radius:5px;
            cursor:pointer;
            color:white;
            background:#007bff;
        }
    </style>

    <!-- External CSS -->
    <link rel="stylesheet" href="style.css">

</head>
<body>

<h1>Types of CSS</h1>

<div class="student-info">
    <p><strong>Name:</strong> Palak Hajare</p>
    <p><strong>PRN:</strong> 24070521237</p>
</div>

<div class="container">

    <!-- Inline CSS -->
    <div class="box" style="background:#ffe6e6;">
        <h2>Welcome to Inline CSS</h2>
        <p>This design is styled using Inline CSS.</p>
        <button>Click Here</button>
    </div>

    <!-- Internal CSS -->
    <div class="box internal">
        <h2>Welcome to Internal CSS</h2>
        <p>This design is styled using Internal CSS.</p>
        <button>Click Here</button>
    </div>

    <!-- External CSS -->
    <div class="box external">
        <h2>Welcome to External CSS</h2>
        <p>This design is styled using External CSS.</p>
        <button>Click Here</button>
    </div>

</div>

</body>
</html>

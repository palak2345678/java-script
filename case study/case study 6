}

.footer {
text-align: center;
margin-top: 25px;
color: #777;
font-size: 14px;
}
</style>
</head>

<body>

<div class="container">

<div class="header">
<h1>String Operations using JavaScript</h1>
<p>Explore basic and advanced string manipulation techniques</p>
</div>

<div class="developer">
<strong>Developer:</strong> Palak Hajare
&nbsp; | &nbsp;
<strong>PRN:</strong> 24070521237
</div>

<!-- BASIC STRING OPERATIONS -->
<div class="section">
<h2>🔤 A) Basic String Operations</h2>

<label>Enter a String:</label>
<input type="text" id="basicString"
placeholder="Enter your string here">

<button onclick="showBasic()">Show Basic Operations</button>

<div class="result" id="basicResult">
Results will appear here...
</div>
</div>

<!-- STRING METHODS -->
<div class="section">
<h2>⚙️ B) Work with Strings</h2>

<label>Enter a String:</label>
<input type="text" id="workString"
placeholder="Example: JavaScript is powerful">

<label>Enter word to search:</label>
<input type="text" id="searchWord"
placeholder="Enter a word">

<label>Enter replacement word:</label>
<input type="text" id="replaceWord"
placeholder="Enter replacement">

<button onclick="stringOperations()">Perform Operations</button>

<div class="result" id="workResult">
Results will appear here...
</div>
</div>

<!-- REVERSE STRING -->
<div class="section">
<h2>🔄 Case Study 1: Reverse a String</h2>

<label>Enter a String:</label>
<input type="text" id="reverseInput"
placeholder="Enter string to reverse">

<button onclick="reverseString()">Reverse String</button>

<div class="result" id="reverseResult">
Result will appear here...
</div>
</div>

<!-- VOWEL COUNT -->
<div class="section">
<h2>🔡 Case Study 2: Count Vowels in a Paragraph</h2>

<label>Enter a Paragraph:</label>
<textarea id="paragraph"
placeholder="Enter your paragraph here..."></textarea>

<button onclick="countVowels()">Count Vowels</button>

<div class="result" id="vowelResult">
Result will appear here...
</div>
</div>

<div class="footer">
JavaScript Practical | String Operations
<br>
© 2026 Palak Hajare
</div>

</div>


<script>

// A) BASIC STRING OPERATIONS
function showBasic() {

let str = document.getElementById("basicString").value;

if (str === "") {
alert("Please enter a string!");
return;
}

document.getElementById("basicResult").innerHTML =
"<span>Original String:</span> " + str + "<br>" +
"<span>Length:</span> " + str.length + "<br>" +
"<span>Uppercase:</span> " + str.toUpperCase() + "<br>" +
"<span>Lowercase:</span> " + str.toLowerCase() + "<br>" +
"<span>First Character:</span> " + str.charAt(0) + "<br>" +
"<span>Last Character:</span> " + str.charAt(str.length - 1);
}


// B) STRING METHODS
function stringOperations() {

let str = document.getElementById("workString").value;
let search = document.getElementById("searchWord").value;
let replace = document.getElementById("replaceWord").value;

if (str === "") {
alert("Please enter a string!");
return;
}

// substring()
let sub = str.substring(0, 10);

// indexOf()
let index = str.indexOf(search);

// split()
let splitString = str.split(" ");

// replace()
let replaced = str.replace(search, replace);

document.getElementById("workResult").innerHTML =
"<span>Original String:</span> " + str + "<br>" +
"<span>substring(0,10):</span> " + sub + "<br>" +
"<span>indexOf():</span> " + index + "<br>" +
"<span>split():</span> " + splitString.join(" | ") + "<br>" +
"<span>replace():</span> " + replaced;
}


// CASE STUDY 1: REVERSE STRING
function reverseString() {

let str = document.getElementById("reverseInput").value;

if (str === "") {
alert("Please enter a string!");
return;
}

let reversed = str.split("").reverse().join("");

document.getElementById("reverseResult").innerHTML =
"<span>Original String:</span> " + str + "<br>" +
"<span>Reversed String:</span> " + reversed;
}


// CASE STUDY 2: COUNT VOWELS
function countVowels() {

let paragraph = document.getElementById("paragraph").value;

if (paragraph === "") {
alert("Please enter a paragraph!");
return;
}

let vowels = paragraph.match(/[aeiouAEIOU]/g);

let count = vowels ? vowels.length : 0;

document.getElementById("vowelResult").innerHTML =
"<span>Total Number of Vowels:</span> " + count;
}

</script>

</body>
</html>

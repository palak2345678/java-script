text-align: center;
margin-bottom: 25px;
font-size: 17px;
}

.section {
background: #f8f9ff;
padding: 25px;
border-radius: 15px;
margin-bottom: 25px;
border-left: 5px solid #667eea;
}

.section h2 {
color: #5a4fcf;
margin-bottom: 18px;
}

label {
font-weight: bold;
display: block;
margin-bottom: 8px;
}

input, textarea {
width: 100%;
padding: 12px;

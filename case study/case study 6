margin-bottom: 30px;
}

.header h1 {
color: #5a4fcf;
font-size: 32px;
margin-bottom: 10px;
}

.header p {
color: #666;
font-size: 16px;
}

.developer {
background: linear-gradient(135deg, #667eea, #764ba2);
color: white;
